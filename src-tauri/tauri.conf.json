{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Editör",
  "version": "0.1.0",
  "identifier": "com.pdfeditor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Editör",
        "width": 1360,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Belgesi",
        "description": "PDF Editör ile aç",
        "role": "Editor"
      }
    ]
  }
}
